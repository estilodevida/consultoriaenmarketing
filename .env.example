# VPS SSH Connection
VPS_HOST=consultoriaenmarketing.com
VPS_USER=consultoriaenmarketing
VPS_PORT=22
VPS_SSH_KEY_PATH=~/.ssh/id_ed25519

# Next.js
NEXT_PUBLIC_SITE_URL=https://consultoriaenmarketing.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (MariaDB on VPS via Virtualmin)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=consultoriaenmarketing
DATABASE_USER=consultoriaenmarketing
DATABASE_PASSWORD=

# AI Chatbot
OPENAI_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
LLM_MODEL=

# Admin Panel
JWT_SECRET=
ADMIN_EMAIL=admin@consultoriaenmarketing.com

# Email (SMTP) — leave empty to use local sendmail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@consultoriaenmarketing.com

# Twenty CRM (integración de leads de onboarding)
# Genera un API key en tu workspace de Twenty CRM (Settings > Developers > API keys)
# Workspace: consultoriaenmarketing
# CON-194: estos valores deben vivir también en la credencial "TwentyCRM_API" de n8n
#          (el workflow de Gestión de Citas NO debe llevar la key en texto plano).
#          Tras obtener la key, migrar a secret proposals de Paperclip (twenty_api_key).
TWENTY_SERVER_URL=https://crm.cl1.nl
TWENTY_API_KEY=

# n8n (credenciales de workflow, no usadas por la web directamente)
# N8N_API_KEY=  # se recomienda inyectar vía secret proposals; n8n.cl1.nl
# N8N_BASE_URL=https://n8n.cl1.nl
